<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             xmlns:vm="using:ChatWithMe.Client.ViewModels"
             x:Class="ChatWithMe.Client.Pages.SettingsPage"
             x:DataType="vm:SettingsPageViewModel">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="28,24,28,28" Spacing="20" MaxWidth="640" HorizontalAlignment="Left">
            <StackPanel Spacing="4">
                <TextBlock Text="设置"
                           FontSize="{arc:ArcDesignTokenResource Type2XL}"
                           FontWeight="Medium"
                           Foreground="{arc:ArcDesignTokenResource Foreground}" />
                <TextBlock Text="这个应用的偏好设置。它们会被保存，下次启动时恢复。"
                           TextWrapping="Wrap"
                           Foreground="{arc:ArcDesignTokenResource TextSecondary}" />
            </StackPanel>

            <arc:Card Title="外观" Description="浅色、深色或跟随系统设置。顶栏中的开关也可以切换。">
                <StackPanel Spacing="16" Margin="0,12,0,0">
                    <arc:SegmentedControl SelectedValue="{Binding Appearance, Mode=TwoWay}"
                                          HorizontalAlignment="Left"
                                          AutomationProperties.Name="外观">
                        <arc:SegmentedOption Value="System" Label="跟随系统" />
                        <arc:SegmentedOption Value="Light" Label="浅色" />
                        <arc:SegmentedOption Value="Dark" Label="深色" />
                    </arc:SegmentedControl>
                    <arc:Select Label="强调色" Width="220" HorizontalAlignment="Left" SelectedValue="{Binding Accent, Mode=TwoWay}">
                        <arc:SelectItem Content="中性" Value="Neutral" />
                        <arc:SelectItem Content="紫罗兰" Value="Violet" />
                        <arc:SelectItem Content="蓝色" Value="Blue" />
                        <arc:SelectItem Content="绿色" Value="Green" />
                        <arc:SelectItem Content="琥珀色" Value="Amber" />
                        <arc:SelectItem Content="橙色" Value="Orange" />
                        <arc:SelectItem Content="珊瑚色" Value="Coral" />
                        <arc:SelectItem Content="玫瑰色" Value="Rose" />
                    </arc:Select>
                </StackPanel>
            </arc:Card>

            <arc:Card Title="通知" Description="选择这个应用要通知你的内容。">
                <StackPanel Spacing="14" Margin="0,12,0,0">
                    <arc:Switch Content="每周摘要" IsChecked="True" />
                    <arc:Switch Content="提及与回复" IsChecked="True" />
                    <arc:Switch Content="产品公告" />
                </StackPanel>
            </arc:Card>
        </StackPanel>
    </ScrollViewer>
</UserControl>
