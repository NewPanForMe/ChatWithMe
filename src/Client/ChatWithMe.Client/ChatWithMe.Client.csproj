<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
        <BuiltInComInteropSupport>false</BuiltInComInteropSupport>
        <!-- The .NET 11 SDK's optimized AOT publish drops Avalonia's compiled XAML ("No precompiled XAML found" at start). -->
        <UseOptimizedPublish>false</UseOptimizedPublish>
        <ApplicationIcon>ico\io.ico</ApplicationIcon>
    </PropertyGroup>
    <ItemGroup>
      <AvaloniaXaml Remove="新文件夹\**" />
      <Compile Remove="新文件夹\**" />
      <EmbeddedResource Remove="新文件夹\**" />
      <None Remove="新文件夹\**" />
    </ItemGroup>

    <ItemGroup>
        <!-- Arc is built against this exact Avalonia version; keep every Avalonia package on it. -->
        <PackageReference Include="Avalonia.Desktop" Version="12.1.5" />
        <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.5" />
        <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.14" />
        <PackageReference Include="TKCode.Arc" Version="1.1.0" />
        <!-- View models: [ObservableProperty] and [RelayCommand] are source-generated, so there is no reflection. -->
        <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
        <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.14" />
        <PackageReference Include="TKCode.Arc.Blocks" Version="1.1.0" />
        <PackageReference Include="TKCode.Arc.Fonts" Version="1.1.0" />
        <!-- Only the Lucide icons the app uses are compiled in. Icons chosen at run time (bindings, data) are declared:
             <LucideIcon Include="Bell;ArrowRight" />, or set <LucideIconsIncludeAll>true</LucideIconsIncludeAll>. -->
        <PackageReference Include="TKCode.Arc.Icons.Lucide" Version="1.1.0" />
    </ItemGroup>

    <ItemGroup>
      <_ArcFoundationThemeXaml Remove="新文件夹\**" />
    </ItemGroup>

    <ItemGroup>
      <_ArcFoundationLanguageFile Remove="新文件夹\**" />
    </ItemGroup>

    <ItemGroup>
      <Content Include="ico\io.ico" />
    </ItemGroup>
</Project>
