{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000",
      "http://localhost:5173",
      "http://localhost:4173"
    ]
  },
  "FileStorage": {
    "MaxFileSizeBytes": 20971520,
    "AllowedExtensions": [
      ".png",
      ".jpg",
      ".jpeg",
      ".gif",
      ".webp",
      ".svg",
      ".pdf",
      ".txt",
      ".md",
      ".json",
      ".csv",
      ".zip",
      ".docx",
      ".xlsx"
    ],
    "StorageRoot": "wwwroot/uploads",
    "MaxFilesPerRequest": 5,
    "PublicUrlPrefix": "/uploads"
  },
  "Jwt": {
    "Issuer": "ChatWithMe.Api",
    "Audience": "ChatWithMe.Client",
    "AccessTokenLifetimeMinutes": 15,
    "RefreshTokenLifetimeDays": 7
  },
  "Mongo": {
    "DatabaseName": "chatwithme",
    "ServerSelectionTimeoutSeconds": 5,
    "AuthSource": "admin"
  },
  "Time": {
    "TimeZoneId": "Asia/Shanghai",
    "FallbackTimeZoneId": "China Standard Time"
  },
  "Security": {
    "ConnectionStringEndpoint": "https://www.tunn.work/ToolsConsole/ConnectionString/GetByConnName?connName=ChatWithMe",
    "ConnectionStringTimeoutSeconds": 20,
    "ConnectionNames": {
      "Postgres": "ChatWithMe",
      "Mongo": "ChatWithMeMongo"
    }
  }
}
